#!/bin/sh
set -eu

# Enable screen blanking / monitor power-off after 10 minutes
xset s on
xset s 600
xset +dpms
xset dpms 0 0 600

# Load X resources for larger fonts (for children)
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Hide cursor after a few seconds
unclutter -idle 3 &

# Minimal window manager. Matchbox shows one app window at a time, sized to
# fill the screen -- that is its design, not an option -- so the only thing to
# turn off is the title bar. Windows of type _NET_WM_WINDOW_TYPE_DOCK are
# the exception: matchbox pins them to a screen edge and shrinks the app to
# fit around them.
matchbox-window-manager -use_titlebar no -use_lowlight &

xbindkeys &

# Run selected app (from run-x.sh)
if [ -n "${KID_APP:-}" ]; then
  # shellcheck disable=SC2086
  exec "$KID_APP" ${KID_ARGS:-}
fi

# Fallback
exec xterm
