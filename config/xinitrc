#!/bin/sh
set -eu

# Enable screen blanking / monitor power-off after 10 minutes
xset s on
xset s 600
xset +dpms
xset dpms 0 0 600

# Load X resources for larger fonts (for children)
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Hide cursor after a few seconds
unclutter -idle 3 &

# Minimal window manager. Matchbox shows one app window at a time, sized to
# fill the screen, and it is what makes Chromium --kiosk and Tux Paint fill
# the screen at all: on bare X neither sizes itself (Chromium sits at its
# 1313x1056 default). Windows of type _NET_WM_WINDOW_TYPE_DOCK are pinned to
# a screen edge and the app is shrunk to fit around them.
#
# Both options take a yes/no VALUE. A bare "-use_lowlight" makes matchbox
# print its usage and exit, leaving no window manager. For months this line
# ended "-use_lowlight -use_fullscreen", which worked only because
# "-use_fullscreen" was being read as lowlight's value (anything but "yes"
# means off).
matchbox-window-manager -use_titlebar no -use_lowlight no &

xbindkeys &

# Run selected app (from run-x.sh)
if [ -n "${KID_APP:-}" ]; then
  # shellcheck disable=SC2086
  exec "$KID_APP" ${KID_ARGS:-}
fi

# Fallback
exec xterm
