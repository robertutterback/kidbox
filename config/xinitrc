#!/bin/sh
set -eu

# Enable screen blanking / monitor power-off after 10 minutes
xset s on
xset s 600
xset +dpms
xset dpms 0 0 600

# Load X resources for larger fonts (for children)
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Hide cursor after a few seconds
unclutter -idle 3 &

# No window manager. Every kidbox app sizes itself to the whole screen
# (Chromium --kiosk, Tux Paint's SDL fullscreen, xterm -maximized), so there
# is nothing to manage. matchbox-window-manager used to be started here with
# a made-up -use_fullscreen flag; matchbox exits on an unknown option, so it
# never actually ran and the session was always bare X. When the flag was
# removed (0cea205) matchbox really started, ignored Chromium's fullscreen
# request and left it at 1313x1056 in the corner. Bare X is what works.
#
# Two consequences of having no WM: keyboard focus follows the pointer, and
# stacking is map order -- a window that must stay visible over an app has
# to raise itself.

xbindkeys &

# Run selected app (from run-x.sh)
if [ -n "${KID_APP:-}" ]; then
  # shellcheck disable=SC2086
  exec "$KID_APP" ${KID_ARGS:-}
fi

# Fallback
exec xterm
